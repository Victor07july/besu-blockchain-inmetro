@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam conditionStyle diamond

start
if (O que deseja fazer?) then (Resgatar Recompensa)
  if (Deseja usar Pseudônimo?) then (Sim)
    :Gerar Pseudônimo;
    :Resgatar via Pseudônimo;
  else (Não)
    :Resgatar via Identidade Real;
  endif
  :Realizar Resgate;
else (Enviar Trajeto)
  :Coleta de Telemetria Bruta;
  if (Deseja aplicar Offset?) then (Sim)
    partition "Oráculo" {
      repeat
        :Gerar Candidato de Deslocamento;
        :Projetar na Malha Viária (OSMnx);
        :Calcular Penalização;
      backward: Iterar (n vezes);
      repeat while (Busca concluída?) is (Não)
      :Apresentar 5 Melhores Opções;
      :Usuário Seleciona Opção;
    }
  else (Não)
    :Manter Trajetória Original;
  endif
  
  partition "Blockchain" {
    :Registro do Trajeto;
  }
endif
stop
@enduml